# Copy to /opt/sbg-coffee/production.env ON THE SERVER; never commit real values.
# Exact lowercase package expected by the deployment script (no tag or digest).
API_IMAGE_REPOSITORY=ghcr.io/your-owner/your-repository-api
API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
POSTGRES_USER=sbg
POSTGRES_DB=sbg
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Password in the URL must be URL-encoded; host is the Compose service, not localhost.
DATABASE_URL=postgresql://sbg:replace-with-a-long-random-password@postgres:5432/sbg?schema=public
# Empty allows no cross-origin browsers. Native mobile requests are unaffected.
CORS_ORIGINS=https://app.example.com
# API_IMAGE is supplied by deploy.sh from its validated digest argument.
