# Expo reads this file from apps/mobile/.env after copying.
EXPO_PUBLIC_CATALOG_SOURCE=mock
# Android emulator: http://10.0.2.2:3000
# USB with adb reverse tcp:3000 tcp:3000: http://localhost:3000
# Wi-Fi physical device: http://<computer-LAN-IP>:3000
# Production: https://<api-domain>
EXPO_PUBLIC_API_URL=http://localhost:3000
