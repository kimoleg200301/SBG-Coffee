{
  "name": "@sbg/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma test",
    "test": "node --import tsx --test test/config.test.ts test/catalog.test.ts test/health.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test test/catalog.integration.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env dist/prisma/seed.js",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "@sbg/contracts": "0.1.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "8.72.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  }
}
